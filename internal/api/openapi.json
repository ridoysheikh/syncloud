{
  "openapi": "3.1.0",
  "info": {
    "title": "SynCloud API",
    "version": "v1",
    "description": "The public SynCloud controller API. The dashboard, synctl and CI all use these endpoints (plan \u00a75.1). Authenticate with the dashboard session cookie, a personal access token (Bearer), or a signed access-key request (SYN1-HMAC-SHA256, plan \u00a77.1)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    },
    {
      "bearerToken": []
    },
    {
      "accessKey": []
    }
  ],
  "paths": {
    "/api/v1/system/status": {
      "get": {
        "operationId": "getSystemStatus",
        "tags": [
          "system"
        ],
        "summary": "Controller version and setup state",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "tags": [
          "system"
        ],
        "summary": "This API description",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "operationId": "completeSetup",
        "tags": [
          "auth"
        ],
        "summary": "Exchange the one-time setup token for the root account and sign in",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Root account created; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "tags": [
          "auth"
        ],
        "summary": "Sign in to the dashboard (sets the session cookie)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": [
          "auth"
        ],
        "summary": "End the current session",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "whoami",
        "tags": [
          "auth"
        ],
        "summary": "The authenticated user",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/stream": {
      "get": {
        "operationId": "stream",
        "tags": [
          "system"
        ],
        "summary": "Live event stream (WebSocket upgrade). Each message is a JSON Event.",
        "responses": {
          "101": {
            "description": "Switching to WebSocket"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/iam/access-keys": {
      "get": {
        "operationId": "listAccessKeys",
        "tags": [
          "iam"
        ],
        "summary": "Your access keys",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessKeyList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAccessKey",
        "tags": [
          "iam"
        ],
        "summary": "Create an access key (max 2 per user). The secret is returned only once.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessKey"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/iam/access-keys/{id}": {
      "delete": {
        "operationId": "deleteAccessKey",
        "tags": [
          "iam"
        ],
        "summary": "Delete one of your access keys",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/iam/tokens": {
      "get": {
        "operationId": "listTokens",
        "tags": [
          "iam"
        ],
        "summary": "Your personal access tokens",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createToken",
        "tags": [
          "iam"
        ],
        "summary": "Create a personal access token. The token is returned only once.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "expiresInDays": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 365,
                    "description": "0 means no expiry"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/iam/tokens/{id}": {
      "delete": {
        "operationId": "deleteToken",
        "tags": [
          "iam"
        ],
        "summary": "Delete one of your personal access tokens",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/nodes/join": {
      "post": {
        "operationId": "joinNode",
        "tags": [
          "nodes"
        ],
        "summary": "Register a node with a join token (used by syncloud-agent join). Returns the node's client certificate signed from its CSR.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/nodes": {
      "get": {
        "operationId": "listNodes",
        "tags": [
          "nodes"
        ],
        "summary": "All nodes with live status and latest metrics",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}": {
      "delete": {
        "operationId": "deleteNode",
        "tags": [
          "nodes"
        ],
        "summary": "Remove a node. Its certificate stops working immediately.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/nodes/join-tokens": {
      "get": {
        "operationId": "listJoinTokens",
        "tags": [
          "nodes"
        ],
        "summary": "Active (unexpired, unused) join tokens",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinTokenList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createJoinToken",
        "tags": [
          "nodes"
        ],
        "summary": "Create a join token. The token is returned only once.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "ttlMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10080,
                    "description": "default 60"
                  },
                  "singleUse": {
                    "type": "boolean",
                    "description": "default true"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinToken"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/nodes/join-tokens/{id}": {
      "delete": {
        "operationId": "deleteJoinToken",
        "tags": [
          "nodes"
        ],
        "summary": "Revoke a join token",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/system/tasks": {
      "get": {
        "operationId": "listSystemTasks",
        "tags": [
          "system"
        ],
        "summary": "Platform components (system tasks) running on the controller node: Traefik, VictoriaMetrics, VictoriaLogs, \u2026",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemTaskList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/registry/token": {
      "get": {
        "operationId": "getRegistryToken",
        "tags": [
          "registry"
        ],
        "summary": "Docker registry token endpoint (used by docker login/push/pull). Basic auth: access key ID + secret, or any username + personal access token.",
        "security": [],
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "schema": {
              "type": "string",
              "const": "syncloud-registry"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": true,
            "description": "e.g. repository:shop/api:pull,push"
          }
        ],
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "access_token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    },
                    "issued_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/settings/domain": {
      "get": {
        "operationId": "getDomainSettings",
        "tags": [
          "settings"
        ],
        "summary": "Base domain, public IP, suggested sslip.io/nip.io domains and ACME settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainSettings"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "setBaseDomain",
        "tags": [
          "settings"
        ],
        "summary": "Change the base domain. The dashboard moves to https://<domain> and the registry to registry.<domain>; certificates are requested automatically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "baseDomain"
                ],
                "properties": {
                  "baseDomain": {
                    "type": "string",
                    "example": "203-0-113-10.sslip.io"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainSettings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/certificates": {
      "get": {
        "operationId": "listCertificates",
        "tags": [
          "settings"
        ],
        "summary": "TLS certificates for the platform hostnames",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/certificates/{host}/renew": {
      "post": {
        "operationId": "renewCertificate",
        "tags": [
          "settings"
        ],
        "summary": "Clear the retry backoff and request a certificate now",
        "parameters": [
          {
            "name": "host",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/backups/config": {
      "get": {
        "operationId": "getBackupConfig",
        "tags": [
          "backups"
        ],
        "summary": "S3 backup destination, schedule and last run",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupSettings"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "setBackupConfig",
        "tags": [
          "backups"
        ],
        "summary": "Set the S3 destination. The bucket is checked before saving; an empty secret keeps the stored one. A first backup starts right away.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackupConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupSettings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "disableBackups",
        "tags": [
          "backups"
        ],
        "summary": "Turn backups off (stored backups are kept)",
        "responses": {
          "204": {
            "description": "Disabled"
          }
        }
      }
    },
    "/api/v1/backups": {
      "get": {
        "operationId": "listBackups",
        "tags": [
          "backups"
        ],
        "summary": "Backups stored in S3, newest first",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupList"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "runBackup",
        "tags": [
          "backups"
        ],
        "summary": "Take a backup now",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupObject"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/backups/download": {
      "get": {
        "operationId": "downloadBackup",
        "tags": [
          "backups"
        ],
        "summary": "Download a fresh encrypted backup bundle (restore needs the recovery key)",
        "responses": {
          "200": {
            "description": "Backup bundle",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/network/mesh": {
      "get": {
        "operationId": "getMesh",
        "tags": [
          "network"
        ],
        "summary": "WireGuard mesh: each node's address, container subnet, endpoint and live peer links",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mesh"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "syncloud_session"
      },
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal access token (syn_pat_\u2026)"
      },
      "accessKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "SYN1-HMAC-SHA256 Credential=<access key id>, Signature=<hex>, with X-Syn-Date and X-Syn-Content-Sha256 headers"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "SystemStatus": {
        "type": "object",
        "required": [
          "version",
          "setupRequired",
          "baseDomain"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "setupRequired": {
            "type": "boolean"
          },
          "baseDomain": {
            "type": "string"
          },
          "recoveryConfirmRequired": {
            "type": "boolean"
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "setupToken",
          "email",
          "name",
          "password"
        ],
        "properties": {
          "setupToken": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 12
          },
          "recoveryKeySuffix": {
            "type": "string",
            "description": "Last 6 characters of the recovery key printed at install (required when status.recoveryConfirmRequired)"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "isRoot",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "isRoot": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccessKey": {
        "type": "object",
        "required": [
          "id",
          "description",
          "createdAt",
          "lastUsedAt",
          "lastUsedIp"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
