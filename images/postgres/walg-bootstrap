#!/bin/sh
# Patroni custom bootstrap for a restored cluster: fetch a base backup from
# the source's archive (walg-restore-env). For a SynCloud source, Patroni
# then recovers it with walg-restore-wal up to the target time and
# promotes it. An archive written outside SynCloud (WALG_RESTORE_EXTERNAL=1)
# is recovered and promoted here instead, and given SynCloud's roles
# (walg-adopt): Patroni then starts a ready primary.
#   WALG_RESTORE_BACKUP  a backup name (default LATEST)
set -eu
datadir=
for a in "$@"; do case "$a" in --datadir=*) datadir=${a#--datadir=} ;; esac; done
[ -n "$datadir" ] || { echo "walg-bootstrap: no --datadir" >&2; exit 1; }
. /usr/local/bin/walg-restore-env
wal-g backup-fetch "$datadir" "${WALG_RESTORE_BACKUP:-LATEST}"
[ "${WALG_RESTORE_EXTERNAL:-}" = 1 ] || exit 0
exec /usr/local/bin/walg-adopt "$datadir"
